Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: cam1_color_optical_frame
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/Image
      Name: Camera 1 - Color
      Enabled: true
      Topic:
        Value: /camera/cam1/color/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Transport Hint: raw
      Queue Size: 2
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: Camera 2 - Color
      Enabled: true
      Topic:
        Value: /camera/cam2/color/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Transport Hint: raw
      Queue Size: 2
      Normalize Range: true
  Tools:
    - Class: rviz_default_plugins/Interact
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2
Window Geometry:
  Width: 1400
  Height: 850
  X: 0
  Y: 0
