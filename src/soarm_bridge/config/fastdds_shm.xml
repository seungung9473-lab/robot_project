<?xml version="1.0" encoding="UTF-8"?>
<!-- 같은 컴퓨터 안 큰 영상(640x480 RGB ≈ 0.9 MB)을 공유메모리로 보내기 위한 Fast DDS 설정.
     기본 공유메모리 조각(0.5 MB)보다 영상이 커서 UDP로 쪼개 보내다 프레임이 빠지는 것을 막는다. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_big</transport_id>
      <type>SHM</type>
      <segment_size>33554432</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="default_participant" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>shm_big</transport_id>
        <transport_id>udp</transport_id>
      </userTransports>
    </rtps>
  </participant>
</profiles>
