# TUMST_ARM USB 장치 이름 고정
# 설치: sudo cp src/TUMST_ARM_bridge/udev/99-TUMST_ARM.rules /etc/udev/rules.d/
#       sudo udevadm control --reload-rules && sudo udevadm trigger
# ID_MM_DEVICE_IGNORE: ModemManager가 ttyACM 포트를 모뎀으로 착각해 건드리지 않게 함

# 서보 버스 (Waveshare URT-2, CH343)  →  /dev/servo_bus
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", SYMLINK+="servo_bus", MODE="0666", ENV{ID_MM_DEVICE_IGNORE}="1"
# ESP32-S3 네이티브 USB 포트 ("USB" 라고 적힌 쪽)  →  /dev/esp32
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", SYMLINK+="esp32", MODE="0666", ENV{ID_MM_DEVICE_IGNORE}="1"
# 턴테이블 (ROBOTIS OpenRB-150 + XL330)  →  /dev/turntable_bus
SUBSYSTEM=="tty", ATTRS{idVendor}=="2f5d", ATTRS{idProduct}=="2202", SYMLINK+="turntable_bus", MODE="0666", ENV{ID_MM_DEVICE_IGNORE}="1"
