Panels:
- Class: rviz_common/Displays
  Help Height: 70
  Name: Displays
  Property Tree Widget:
    Expanded: null
    Splitter Ratio: 0.5
  Tree Height: 160
- Class: soarm4_moveit_config/HomePanel
  Name: SO-ARM4 Home
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 0.05000000074505806
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 20
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: moveit_rviz_plugin/MotionPlanning
    Name: MotionPlanning
    Enabled: true
    Robot Description: robot_description
    Planning Scene Topic: /monitored_planning_scene
    Move Group Namespace: ''
    Planning Request:
      Planning Group: arm
      Query Start State: false
      Query Goal State: false
      Goal State Alpha: 0.45
    Planned Path:
      Trajectory Topic: /display_planned_path
      Loop Animation: false
      State Display Time: 0.08 s
      Robot Alpha: 0.65
    Scene Robot:
      Robot Alpha: 0.8
    Scene Geometry:
      Scene Alpha: 1.0
      Show Scene Geometry: true
  - Class: rviz_default_plugins/MarkerArray
    Name: Workcell and reconstructed objects
    Enabled: true
    Namespaces: {}
    Topic:
      Value: /workcell_markers
      Depth: 10
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Value: true
  Enabled: true
  Global Options:
    Background Color: 235; 238; 242
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.35
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: -0.03
        Y: 0.23
        Z: 0.12
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.65
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 1.4350051879882812
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 850
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: ''
  Width: 1200
  X: 0
  Y: 0
