# 서보 버스 (Waveshare URT-2, CH343)  →  /dev/servo_bus
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", SYMLINK+="servo_bus", MODE="0666"
# ESP32-S3 네이티브 USB 포트 ("USB" 라고 적힌 쪽)  →  /dev/esp32
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", SYMLINK+="esp32", MODE="0666"
