Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 0.05
      Plane Cell Count: 20
      Reference Frame: base_link
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Topic:
        Value: /robot_description
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Marker Scale: 0.06
      Show Names: true
      Frames:
        All Enabled: false
        base_link: {Value: true}
        link1: {Value: true}
        link2: {Value: true}
        link3: {Value: true}
        tool_link: {Value: true}
        cup_tip: {Value: true}
      Value: true
  Global Options:
    Fixed Frame: base_link
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.9
      Focal Point: {X: 0.1, Y: 0, Z: 0.15}
      Pitch: 0.45
      Yaw: 3.9
