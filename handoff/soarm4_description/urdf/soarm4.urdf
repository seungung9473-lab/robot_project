<?xml version="1.0"?>
<!-- SO-ARM4 (SO-ARM101 based 4-DOF + vacuum tool v5) on the electronics box.  Generated by make_urdf_v2.py - edit that, not this.
     Geometry = official SO-101 CAD (TheRobotStudio so101_new_calib.urdf) + our parts.
     base_link : table surface right under the J1 axis.  x = forward (box front wall), y = left, z = up.
     zero pose : arm stretched forward and level.  joint1 + = CCW from above, joint2/3/4 + = link goes up.
     servo count <-> angle : config/servo_map.yaml  (same as v1, soarm_bridge unchanged)
     key numbers (mm, base_link) : box top z 95.0 | J1 output z 159.8 | J2 axis x 30.4 z 214.0
                                   J2->J3 (112.6, -28.0) | J3->J4 (134.9, 5.2) | J4->cup lip (104.0, -0.5, 0.0) -->
<robot name="soarm4">
  <material name="print"><color rgba="0.92 0.92 0.88 1"/></material><material name="servo"><color rgba="0.10 0.10 0.10 1"/></material><material name="alu"><color rgba="0.75 0.77 0.80 1"/></material><material name="cup"><color rgba="0.10 0.55 0.95 1"/></material><material name="box_plate"><color rgba="0.30 0.42 0.62 1"/></material><material name="box_wall"><color rgba="0.62 0.46 0.36 1"/></material>
  <link name="world"/>
  <joint name="world_fixed" type="fixed"><parent link="world"/><child link="base_link"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

  <link name="base_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://soarm4_description/meshes/visual/base_link_print.stl"/></geometry><material name="print"/></visual>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://soarm4_description/meshes/visual/base_link_servo.stl"/></geometry><material name="servo"/></visual>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://soarm4_description/meshes/visual/base_link_box_plate.stl"/></geometry><material name="box_plate"/></visual>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://soarm4_description/meshes/visual/base_link_box_wall.stl"/></geometry><material name="box_wall"/></visual>
    <collision><origin xyz="-0.0177 -0.0275 0.0475" rpy="0 0 0"/><geometry><box size="0.2000 0.1700 0.0950"/></geometry></collision>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://soarm4_description/meshes/collision/base_link.stl"/></geometry></collision>
    <inertial><origin xyz="-0.0183 -0.0208 0.0673" rpy="0 0 0"/><mass value="0.7280"/><inertia ixx="2.753e-03" ixy="1.283e-05" ixz="6.264e-05" iyy="3.355e-03" iyz="-1.190e-04" izz="3.810e-03"/></inertial>
  </link>
  <joint name="joint1" type="revolute"><parent link="base_link"/><child link="link1"/>
    <origin xyz="0.00000 0.00000 0.15980" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.1859" upper="1.8208" effort="2.9" velocity="2.36"/>
  </joint>

  <link name="link1">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://soarm4_description/meshes/visual/link1_servo.stl"/></geometry><material name="servo"/></visual>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://soarm4_description/meshes/visual/link1_print.stl"/></geometry><material name="print"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://soarm4_description/meshes/collision/link1.stl"/></geometry></collision>
    <inertial><origin xyz="0.0275 0.0003 0.0218" rpy="0 0 0"/><mass value="0.1106"/><inertia ixx="1.053e-04" ixy="2.047e-07" ixz="-1.034e-05" iyy="1.128e-04" iyz="-1.084e-07" izz="4.208e-05"/></inertial>
  </link>
  <joint name="joint2" type="revolute"><parent link="link1"/><child link="link2"/>
    <origin xyz="0.03040 0.00000 0.05420" rpy="0 0 0"/><axis xyz="0 -1 0"/>
    <limit lower="0.0000" upper="3.3993" effort="2.9" velocity="2.36"/>
  </joint>

  <link name="link2">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://soarm4_description/meshes/visual/link2_servo.stl"/></geometry><material name="servo"/></visual>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://soarm4_description/meshes/visual/link2_print.stl"/></geometry><material name="print"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://soarm4_description/meshes/collision/link2.stl"/></geometry></collision>
    <inertial><origin xyz="0.0861 0.0004 -0.0082" rpy="0 0 0"/><mass value="0.1156"/><inertia ixx="4.836e-05" ixy="9.409e-07" ixz="1.538e-05" iyy="1.864e-04" iyz="-3.034e-10" izz="2.019e-04"/></inertial>
  </link>
  <joint name="joint3" type="revolute"><parent link="link2"/><child link="link3"/>
    <origin xyz="0.11257 0.00000 -0.02800" rpy="0 0 0"/><axis xyz="0 -1 0"/>
    <limit lower="-3.1401" upper="0.0000" effort="2.9" velocity="2.36"/>
  </joint>

  <link name="link3">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://soarm4_description/meshes/visual/link3_print.stl"/></geometry><material name="print"/></visual>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://soarm4_description/meshes/visual/link3_servo.stl"/></geometry><material name="servo"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://soarm4_description/meshes/collision/link3.stl"/></geometry></collision>
    <inertial><origin xyz="0.0885 0.0005 0.0034" rpy="0 0 0"/><mass value="0.1173"/><inertia ixx="4.014e-05" ixy="-1.207e-06" ixz="-5.939e-06" iyy="2.099e-04" iyz="-1.275e-07" izz="2.315e-04"/></inertial>
  </link>
  <joint name="joint4" type="revolute"><parent link="link3"/><child link="tool_link"/>
    <origin xyz="0.13490 0.00000 0.00520" rpy="0 0 0"/><axis xyz="0 -1 0"/>
    <limit lower="-1.8807" upper="2.1276" effort="1.9" velocity="3.3"/>
  </joint>

  <link name="tool_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://soarm4_description/meshes/visual/tool_link_print.stl"/></geometry><material name="print"/></visual>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://soarm4_description/meshes/visual/tool_link_alu.stl"/></geometry><material name="alu"/></visual>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://soarm4_description/meshes/visual/tool_link_cup.stl"/></geometry><material name="cup"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://soarm4_description/meshes/collision/tool_link.stl"/></geometry></collision>
    <inertial><origin xyz="0.0604 -0.0070 -0.0008" rpy="0 0 0"/><mass value="0.0348"/><inertia ixx="6.669e-06" ixy="-4.724e-06" ixz="1.821e-07" iyy="2.745e-05" iyz="-1.160e-08" izz="3.056e-05"/></inertial>
  </link>

  <!-- suction point: centre of the cup lip, x = approach direction -->
  <joint name="cup_tip_fixed" type="fixed"><parent link="tool_link"/><child link="cup_tip"/><origin xyz="0.10400 -0.00048 0.00000" rpy="0 0 0"/></joint>
  <link name="cup_tip"/>
  <!-- helper frames -->
  <joint name="box_top_fixed" type="fixed"><parent link="base_link"/><child link="box_top"/><origin xyz="0 0 0.0950" rpy="0 0 0"/></joint>
  <link name="box_top"/>
  <joint name="box_cad_fixed" type="fixed"><parent link="base_link"/><child link="box_cad"/><origin xyz="-0.01770 -0.02750 0.09500" rpy="0 0 0.000000"/></joint>
  <link name="box_cad"/>
</robot>
